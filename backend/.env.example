# Server Configuration
PORT=7000
NODE_ENV=development
# Comma-separated allowlist. Production example: https://your-domain.example,https://www.your-domain.example
CLIENT_URL=http://localhost:5173
# Public frontend origin used in password-reset email links
# Local: http://localhost:5173 | Production: https://your-domain.example
FRONTEND_URL=http://localhost:5173

# Where admin-uploaded images are stored. Default: backend/uploads. On a host, point this at a persistent disk
# (Render: UPLOADS_DIR=/var/data/uploads with a disk mounted at /var/data).
# UPLOADS_DIR=

# Database
# If mongodb+srv fails with "querySrv ECONNREFUSED" on your network, uncomment:
# DNS_SERVERS=8.8.8.8,1.1.1.1
MONGO_URI=mongodb://localhost:27017/wholesale_db

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production_123456
JWT_EXPIRES_IN=7d

# Admin password recovery (forgot password)
# Reset emails are ALWAYS delivered to ADMIN_RECOVERY_EMAIL (never from the form destination)
ADMIN_LOGIN_EMAIL=admin@supplierfy.com
ADMIN_RECOVERY_EMAIL=admin@supplierfy.com
# Password for the seeded super admin (first boot). In production, if unset, a random one is generated and printed once.
ADMIN_DEFAULT_PASSWORD=
# Gmail SMTP (App Password — never commit real SMTP_PASS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@example.com
SMTP_PASS=
SMTP_FROM=admin@example.com

# SMS / OTP Provider (Fast2SMS)
# Leave SMS_API_KEY as placeholder / empty to run OTP demo mode (code 123456) on the server.
# Set a real Fast2SMS key + (optional) DLT TEMPLATE_ID for live SMS delivery.
SMS_PROVIDER=fast2sms
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=DRYFWS
SMS_TEMPLATE_ID=
# Force demo OTP (123456) even if SMS_API_KEY is set: OTP_DEMO_MODE=true
# Force live SMS path: OTP_DEMO_MODE=false
OTP_DEMO_MODE=

# Razorpay Payment Gateway (Optional until live credentials are provided)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Bigship Shipping (server-side only — never use VITE_ prefixes, never commit real values)
# Panel: API Integration page -> enable "User API Status" and copy the Access Key.
BIGSHIP_USER_NAME=your_bigship_login_email
BIGSHIP_PASSWORD=your_bigship_login_password
BIGSHIP_ACCESS_KEY=your_bigship_access_key
BIGSHIP_BASE_URL=https://api.bigship.direct
# Numeric id of the pickup warehouse created in the Bigship panel (empty = first active warehouse)
BIGSHIP_PICKUP_WAREHOUSE_ID=
# Pickup pincode for checkout rate quotes (Admin Settings warehouse pincode wins if set)
BIGSHIP_PICKUP_PINCODE=
# Push the order to Bigship when admin marks it Packed
BIGSHIP_AUTO_CREATE=true
# Checkout live rate quotes (false = store settings fees while testing)
BIGSHIP_CHECKOUT_QUOTES=true
# create = draft order only (no wallet charge) | awb = also book courier + AWB (charges wallet) | full = + label/invoice
BIGSHIP_AUTO_FULFILL=create
# Bigship has no webhooks: sync shipment status every N minutes (0 = off)
BIGSHIP_TRACK_SYNC_MINUTES=15
# Standard shipping box for one order (cm) when products have no own pack size. Weight comes from the order items.
BIGSHIP_DEFAULT_WEIGHT_KG=0.2
BIGSHIP_DEFAULT_LENGTH_CM=30
BIGSHIP_DEFAULT_BREADTH_CM=25
BIGSHIP_DEFAULT_HEIGHT_CM=20
