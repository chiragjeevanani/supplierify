# Frontend App Configuration
VITE_APP_NAME="Dry Fruit Wholesale"
VITE_APP_ENV=development

# Local API URL belongs in `.env.development` only (never in shared `.env`).
# Production builds use same-origin: https://your-domain.example/api/v1
# VITE_API_URL=http://localhost:7000/api/v1

# Live Bigship checkout rates (false = store settings fees; set true once Bigship is connected)
VITE_SHIPPING_CHECKOUT_ENABLED=false
